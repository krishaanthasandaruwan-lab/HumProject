# Copy to .env.local and fill in. Never commit real keys.
# Unlock every Pro feature for testing builds:
VITE_DEV_PRO=false
# RevenueCat → Project → API keys → Google Play public SDK key:
VITE_REVENUECAT_ANDROID_KEY=
# RevenueCat → Project → API keys → App Store public SDK key:
VITE_REVENUECAT_IOS_KEY=
# Monthly subscriptions in ONE Apple subscription group. Pro inherits Plus in the app.
VITE_PLUS_ENTITLEMENT=plus
VITE_PLUS_PRODUCT_ID=humm_plus_monthly
VITE_PRO_ENTITLEMENT=pro
VITE_PRO_PRODUCT_ID=humm_pro_monthly
# Publish the privacy webpage and create the support mailbox before the release build.
VITE_PRIVACY_POLICY_URL=
VITE_SUPPORT_EMAIL=
# Store listings (used by the web version's membership button):
VITE_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.krishanthasandaruwan.humm
VITE_APP_STORE_URL=
