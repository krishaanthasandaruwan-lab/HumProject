# Copy to .env.local and fill in. Never commit real keys.
# Unlock every Pro feature for testing builds:
VITE_DEV_PRO=false
# RevenueCat → Project → API keys → Google Play public SDK key:
VITE_REVENUECAT_ANDROID_KEY=goog_xxxxxxxxxxxxxxxxxxxxxxxx
# RevenueCat entitlement that the $0.99 product unlocks:
VITE_PRO_ENTITLEMENT=pro
# Play Store listing (used by the web version's "Get Pro" button):
VITE_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.mouthband.app
